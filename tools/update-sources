#!/usr/bin/env python3
"""Pin an NI-DAQmx release into the PKGBUILD.

Downloads NI's signed Ubuntu apt index for one release, verifies the signature
with the bundled NI key, resolves every NI package `ni-daqmx` depends on, and
rewrites the source/sha256 arrays between the NI SOURCES markers in PKGBUILD.

Usage: tools/update-sources [YEAR/QUARTER]      e.g. tools/update-sources 2026/Q3
"""
import gzip
import hashlib
import re
import subprocess
import sys
import tempfile
import urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
KEY = ROOT / "keys" / "ni-software-2026.asc"
PKGBUILD = ROOT / "ni-daqmx" / "PKGBUILD"
DISTRO = "noble"
TOP_PACKAGE = "ni-daqmx"


def fetch(url):
    with urllib.request.urlopen(url) as r:
        return r.read()


def verify_inrelease(data):
    """Check the InRelease signature against the bundled key; return the signed text."""
    with tempfile.TemporaryDirectory() as tmp:
        keyring = Path(tmp) / "ni.gpg"
        subprocess.run(["gpg", "--batch", "--quiet", "--dearmor", "-o", keyring, KEY], check=True)
        out = subprocess.run(["gpgv", "--keyring", keyring, "--output", "-"],
                             input=data, capture_output=True)
        if out.returncode:
            sys.exit(f"InRelease signature check failed:\n{out.stderr.decode()}")
        return out.stdout.decode()


def parse_packages(text):
    idx = {}
    for block in text.split("\n\n"):
        f = dict(re.findall(r"^([\w-]+): (.*)$", block, re.M))
        if "Package" in f:
            idx[f["Package"]] = f
    for f in list(idx.values()):
        for p in f.get("Provides", "").split(","):
            p = re.sub(r"\(.*\)", "", p).strip()
            if p and p not in idx:
                idx[p] = f
    return idx


def closure(idx, top):
    seen, external, todo = {}, set(), [top]
    while todo:
        f = idx[todo.pop()]
        if f["Package"] in seen:
            continue
        seen[f["Package"]] = f
        for field in ("Pre-Depends", "Depends"):
            for alt in f.get(field, "").split(","):
                names = [re.sub(r"\(.*\)|:any", "", a).strip() for a in alt.split("|")]
                names = [n for n in names if n]
                hit = [n for n in names if n in idx]
                if hit:
                    todo.append(hit[0])
                elif names:
                    external.add(" | ".join(names))
    return seen, external


def main():
    release = sys.argv[1] if len(sys.argv) > 1 else "2026/Q3"
    base = f"https://download.ni.com/ni-linux-desktop/{release}/deb/ni/{DISTRO}"
    signed = verify_inrelease(fetch(f"{base}/dists/{DISTRO}/InRelease"))

    want = f"ni/binary-amd64/Packages.gz"
    m = re.search(rf"^SHA256:\n((?: .*\n)+)", signed, re.M)
    sums = {line.split()[2]: line.split()[0] for line in m.group(1).splitlines()}
    raw = fetch(f"{base}/dists/{DISTRO}/{want}")
    if hashlib.sha256(raw).hexdigest() != sums[want]:
        sys.exit("Packages.gz does not match the signed checksum")

    pkgs, external = closure(parse_packages(gzip.decompress(raw).decode()), TOP_PACKAGE)
    version = pkgs[TOP_PACKAGE]["Version"]
    lines = [f"_ni_release={release}", f"_ni_daqmx_version={version}", "_ni_debs=("]
    lines += [f"  {f['Filename']}" for _, f in sorted(pkgs.items())]
    lines += [")", "_ni_sha256s=("]
    lines += [f"  {f['SHA256']}" for _, f in sorted(pkgs.items())]
    lines += [")"]

    text = PKGBUILD.read_text()
    new = re.sub(r"(# BEGIN NI SOURCES.*?\n).*?(# END NI SOURCES)",
                 lambda m: m.group(1) + "\n".join(lines) + "\n" + m.group(2), text, flags=re.S)
    PKGBUILD.write_text(new)

    size = sum(int(f["Size"]) for f in pkgs.values()) >> 20
    print(f"NI {release}: {TOP_PACKAGE} {version}, {len(pkgs)} packages, {size} MiB")
    print("Ubuntu dependencies (must be covered by depends=() in PKGBUILD):")
    print("  " + ", ".join(sorted(external)))


if __name__ == "__main__":
    main()
