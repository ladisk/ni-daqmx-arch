# Runs after DKMS (70-dkms-install.hook): builds the NI modules that hook skipped
# (it mis-orders modules with several BUILD_DEPENDS) and warns if any failed.
[Trigger]
Operation = Install
Operation = Upgrade
Type = Path
Target = usr/lib/modules/*/vmlinuz
Target = usr/lib/modules/*/build/include/
Target = usr/src/ni*/dkms.conf

[Action]
Description = Checking NI-DAQmx kernel modules...
When = PostTransaction
Exec = /usr/bin/ni-daqmx-omarchy hook-check
