#!/bin/bash
# ni-daqmx-arch: check, test, rebuild and update NI-DAQmx on Arch Linux.

set -uo pipefail

REPO=${NI_DAQMX_ARCH_REPO:-$HOME/.local/share/ni-daqmx-arch}
VM_RULE=/etc/udev/rules.d/90-ni-daq-vm.rules
REPORT=${NI_DAQMX_REPORT:-$HOME/ni-daqmx-report.txt}
CORE_MODULES=(nikal nipalk)
# NI's services, as enabled by ni-daqmx.install. nidrum drives USB devices from user space.
UNITS=(nipal nidevldu nimxssvr nisvcloc nisds niroco nipxicmsd ni-pxipf-nipxirm-bind nidrum)

ok()   { printf '  \e[32m✓\e[0m %s\n' "$*"; }
bad()  { printf '  \e[31m✗\e[0m %s\n' "$*"; FAILED=1; }
warn() { printf '  \e[33m!\e[0m %s\n' "$*"; }
hint() { printf '      → %s\n' "$*"; }

usage() {
  cat <<EOF
Usage: ni-daqmx-arch <command>

  doctor        Check every layer (kernel modules, services, devices) and write
                a full report to $REPORT
  test          List NI devices through the Python nidaqmx API
  start         Load the kernel modules and start NI's services now
  rebuild       Force-rebuild the NI kernel modules for the running kernel
  build-modules Build any NI kernel modules still missing, for every kernel
  update        Pull the latest installer, rebuild/reinstall, restart services, run doctor
  mode native   Use NI hardware on this machine (stop forwarding it to the ni-daq VM)
  mode vm       Forward NI hardware to the ni-daq VM again
  uninstall     Remove the package and everything it set up
EOF
}

kernel_has_modules() {
  local k=$1 m
  for m in "${CORE_MODULES[@]}"; do
    modinfo -k "$k" "$m" >/dev/null 2>&1 || return 1
  done
}

cmd_doctor() {
  FAILED=0
  local k=$(uname -r)
  echo "Kernel"
  ok "running $k ($(pacman -Qqo /usr/lib/modules/$k 2>/dev/null | head -1))"
  if [[ -d /usr/lib/modules/$k/build ]]; then ok "headers installed"
  else bad "no headers for $k"; hint "install the matching *-headers package, or reboot into the newest kernel"; fi

  echo "Kernel modules (DKMS)"
  if kernel_has_modules "$k"; then ok "nikal and nipalk built for $k"
  else bad "NI modules are not built for $k"; hint "ni-daqmx-arch rebuild   (shows the compiler error)"; fi
  local failed_builds=$(dkms status -k "$k" 2>/dev/null | grep -E '^ni' | grep -vc installed)
  [[ $failed_builds == 0 ]] && ok "all $(dkms status -k "$k" | grep -c '^ni') NI DKMS modules installed" \
    || bad "$failed_builds NI DKMS modules not installed"
  if [[ $(cat /sys/module/nipalk/initstate 2>/dev/null) == live ]]; then ok "nipalk loaded"
  else bad "nipalk not loaded"; hint "ni-daqmx-arch start, then check: journalctl -b -u nipal"; fi
  [[ -c /dev/nipalk ]] && ok "/dev/nipalk present" || bad "/dev/nipalk missing"

  echo "Services"
  local u
  for u in "${UNITS[@]}"; do
    systemctl is-active -q $u && ok "$u running" || { bad "$u not running"; hint "journalctl -b -u $u"; }
  done

  echo "Hardware"
  if [[ -f $VM_RULE ]]; then
    warn "NI USB devices are being forwarded to the ni-daq VM"
    hint "ni-daqmx-arch mode native"
  fi
  local usb=$(lsusb -d 3923: 2>/dev/null)
  [[ -n $usb ]] && ok "NI USB device: ${usb#*ID }" || warn "no NI USB device plugged in"

  echo
  write_report
  if (( FAILED )); then
    echo "Something is broken. Full details: $REPORT"
    echo "Hand that file to Claude (or open an issue) to get it fixed."
  else
    echo "All checks passed. Next: ni-daqmx-arch test"
  fi
  return $FAILED
}

write_report() {
  local k=$(uname -r)
  {
    echo "# ni-daqmx-arch report, $(date -Is)"
    echo "## system";   uname -a; grep -E '^(NAME|BUILD_ID)=' /etc/os-release; omarchy-version 2>/dev/null
    echo "## packages"; pacman -Q ni-daqmx dkms $(pacman -Qqo /usr/lib/modules/*/vmlinuz 2>/dev/null) 2>&1
    echo "## installer"; git -C "$REPO" log -1 --format='%h %s (%cs)' 2>&1
    echo "## dkms status"; dkms status 2>&1 | grep -E '^ni'
    echo "## dkms build logs (failed only)"
    local log
    for log in /var/lib/dkms/ni*/*/build/make.log /var/lib/dkms/ni*/*/$k/*/log/make.log; do
      [[ -f $log ]] && grep -qiE 'error|undefined' "$log" && { echo "### $log"; tail -60 "$log"; }
    done
    echo "## lsmod";   lsmod | grep -E '^ni'
    echo "## services"; systemctl --no-pager status "${UNITS[@]}" 2>&1 | head -150
    echo "## journal";  journalctl -b --no-pager -u 'ni*' 2>&1 | tail -80
    echo "## kernel log"; journalctl -k -b --no-pager 2>&1 | grep -iE 'ni(kal|pal|pxi|devnode)|natinst|3923' | tail -60
    echo "## usb"; lsusb -d 3923: 2>&1
  } > "$REPORT" 2>&1
}

cmd_test() {
  command -v uv >/dev/null || { echo "uv is needed for the Python test (pacman -S uv)"; exit 1; }
  uv run --quiet --no-project --with nidaqmx python - <<'EOF'
import nidaqmx.system
s = nidaqmx.system.System.local()
v = s.driver_version
print(f"NI-DAQmx {v.major_version}.{v.minor_version}.{v.update_version} is talking to Python.")
devs = list(s.devices)
if not devs:
    print("No devices found. Plug in the hardware and run: ni-daqmx-arch doctor")
for d in devs:
    print(f"  {d.name}: {d.product_type}  (serial {d.serial_num:X})")
    for c in d.ai_physical_chans:
        print(f"      {c.name}")
EOF
}

cmd_start() {
  sudo systemctl start "${UNITS[@]}" && echo "NI services started."
}

cmd_rebuild() {
  [[ $EUID -eq 0 ]] || exec sudo "$0" rebuild "$@"
  build_modules "$(uname -r)" force
  systemctl restart "${UNITS[@]}"
}

# Ask for the sudo password once, then keep sudo's cached login fresh until this
# script exits: the DKMS module builds take longer than sudo's 5-minute timeout.
sudo_keepalive() {
  sudo -v || exit 1
  while sleep 60; do sudo -n true 2>/dev/null || exit; kill -0 $$ 2>/dev/null || exit; done &
  trap "kill $! 2>/dev/null" EXIT
}

# "pkgver-pkgrel" a PKGBUILD directory would build.
pkgbuild_version() {
  (cd "$1" && makepkg --printsrcinfo) | awk '$1=="pkgver"{v=$3} $1=="pkgrel"{r=$3} END{print v"-"r}'
}

# Build the packages whose version differs from the installed one (the helper
# takes seconds, the driver ~1 minute plus a full DKMS rebuild on install), then
# install them in one pacman transaction so files can move between them.
cmd_update() {
  [[ -d $REPO/.git ]] || { echo "Installer checkout not found at $REPO"; exit 1; }
  sudo_keepalive
  git -C "$REPO" pull --ff-only || exit 1

  local out=$REPO/build pkgs=() driver_changed=0 fresh=0 name want have
  # NI's ~280 MB of .debs live outside the checkout, so they survive a re-clone.
  export SRCDEST=${SRCDEST:-${XDG_CACHE_HOME:-$HOME/.cache}/ni-daqmx-arch/src}
  # Packages are built and installed locally, never shipped: skip compressing 1.4 GB.
  export PKGEXT=${PKGEXT:-.pkg.tar}
  mkdir -p "$out" "$SRCDEST"
  for name in ni-daqmx-arch ni-daqmx; do
    want=$(pkgbuild_version "$REPO/$name")
    have=$(pacman -Q "$name" 2>/dev/null | awk '{print $2}')
    if [[ $want == "$have" ]]; then
      echo "==> $name $have is up to date"
      continue
    fi
    echo "==> Building $name $want (installed: ${have:-none})"
    # Keep only the newest build: the driver package is ~400 MB. -c removes the
    # unpacked src/ and pkg/ trees (~1 GB) once the package is written.
    rm -f "$out/$name"-[0-9r]*.pkg.tar*
    (cd "$REPO/$name" && PKGDEST=$out makepkg -f -c --nodeps) || exit 1
    pkgs+=($(cd "$REPO/$name" && PKGDEST=$out makepkg --packagelist))
    [[ $name == ni-daqmx ]] && driver_changed=1 && [[ -z $have ]] && fresh=1
  done

  if ((${#pkgs[@]})); then
    sudo pacman -U --noconfirm "${pkgs[@]}" || exit 1
  fi
  if (( driver_changed )); then
    # try-restart on upgrades: leaves the services off while the hardware is
    # handed to the VM (mode vm). A first install starts them.
    if (( fresh )); then sudo systemctl start "${UNITS[@]}"
    else sudo systemctl try-restart "${UNITS[@]}"; fi
  fi
  echo
  cmd_doctor
}

cmd_mode() {
  case ${1:-} in
    native)
      [[ -f $VM_RULE ]] && sudo mv "$VM_RULE" "$VM_RULE.disabled"
      sudo udevadm control --reload
      virsh -c qemu:///system list --name 2>/dev/null | grep -qx ni-daq \
        && virsh -c qemu:///system shutdown ni-daq >/dev/null
      sudo systemctl enable --now "${UNITS[@]}" >/dev/null 2>&1
      echo "NI hardware now stays on this machine. Re-plug it, then: ni-daqmx-arch doctor" ;;
    vm)
      [[ -f $VM_RULE.disabled ]] && sudo mv "$VM_RULE.disabled" "$VM_RULE"
      sudo udevadm control --reload
      # Disabled, not just stopped: at boot nidrum would claim the chassis before the VM.
      sudo systemctl disable --now "${UNITS[@]}" >/dev/null 2>&1
      virsh -c qemu:///system start ni-daq >/dev/null 2>&1
      echo "NI hardware is forwarded to the ni-daq VM again. Re-plug it." ;;
    *) echo "Usage: ni-daqmx-arch mode native|vm"; exit 1 ;;
  esac
}

# Build every NI DKMS module that is not installed yet for kernel $1, in dependency
# order. The PKGBUILD chains BUILD_DEPENDS so Arch's DKMS hook builds them in order;
# this catches whatever that hook still left unbuilt, using NI's real dependency
# lists (NI_BUILD_DEPENDS), so one failed module does not block unrelated ones.
# --force: dkms would otherwise refuse while a chained predecessor is missing. Runs as root.
build_modules() {
  local k=$1 conf progress=1 built=0 force=${2:-}
  local -A installed=()
  local line
  while read -r line; do
    [[ $line =~ ^([^/]+)/[^,]+,\ $k,.*:\ installed ]] && installed[${BASH_REMATCH[1]}]=1
  done < <(dkms status -k "$k" 2>/dev/null)
  [[ -n $force ]] && installed=()

  while (( progress )); do
    progress=0
    for conf in /usr/src/ni*-*/dkms.conf; do
      local name ver deps dep ready=1
      # dkms.conf refers to DKMS's own variables, so read it with -u off.
      read -r name ver deps < <(set +u; source "$conf"; echo "$PACKAGE_NAME $PACKAGE_VERSION ${NI_BUILD_DEPENDS[*]:-${BUILD_DEPENDS[*]}}")
      [[ -n $name && -n $ver ]] || { echo "==> cannot parse $conf"; continue; }
      [[ -n ${installed[$name]:-} ]] && continue
      for dep in $deps; do [[ -n ${installed[$dep]:-} ]] || ready=0; done
      (( ready )) || continue
      echo "==> building $name/$ver for $k"
      if [[ -n ${NI_DRY_RUN:-} ]] || dkms install --no-depmod --force "$name/$ver" -k "$k" >/dev/null; then
        installed[$name]=1; progress=1; built=1
      else
        echo "==> FAILED: $name/$ver for $k (log: /var/lib/dkms/$name/$ver/build/make.log)"
        installed[$name]=failed
      fi
    done
  done
  (( built )) && [[ -z ${NI_DRY_RUN:-} ]] && depmod "$k"
  return 0
}

cmd_build_modules() {
  [[ $EUID -eq 0 ]] || exec sudo "$0" build-modules
  local dir
  for dir in /usr/lib/modules/*/build; do
    build_modules "$(basename "$(dirname "$dir")")"
  done
}

# Called by the pacman hook after DKMS has run (as root, no desktop).
cmd_hook_check() {
  compgen -G '/usr/src/nikal-*/dkms.conf' >/dev/null || return 0   # driver not installed
  cmd_build_modules
  local dir k bad=()
  for dir in /usr/lib/modules/*/build; do
    k=$(basename "$(dirname "$dir")")
    kernel_has_modules "$k" || bad+=("$k")
  done
  ((${#bad[@]})) || return 0
  echo "==> WARNING: NI-DAQmx kernel modules failed to build for: ${bad[*]}"
  echo "==>          NI hardware will not work on that kernel until this is fixed."
  echo "==>          Run 'ni-daqmx-arch doctor' after rebooting for details."
  return 0
}

case ${1:-} in
  doctor) cmd_doctor ;;
  test) cmd_test ;;
  start) cmd_start ;;
  rebuild) cmd_rebuild ;;
  update) cmd_update ;;
  mode) shift; cmd_mode "$@" ;;
  build-modules) cmd_build_modules ;;
  hook-check) cmd_hook_check ;;
  uninstall) sudo pacman -Rns ni-daqmx ni-daqmx-arch ;;
  *) usage ;;
esac
