+static char *nikal_strncpy(char *dest, const char *src, size_t count)
+{
+   /* strncpy semantics (zero-pad to count); kernel 7.x no longer exports strncpy */
+   size_t i = 0;
+   for (; i < count && src[i]; ++i)
+      dest[i] = src[i];
+   for (; i < count; ++i)
+      dest[i] = '\0';
+   return dest;
+}
+
 char *nNIKAL250_strnCpy(char *dest, const char *src, size_t count)
 {
-   return __builtin_strncpy(dest, src, count);
+   return nikal_strncpy(dest, src, count);
 }
 
