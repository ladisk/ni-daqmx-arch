# END NI SOURCES

pkgver=${_ni_daqmx_version%%-*}
_ni_base="https://download.ni.com/ni-linux-desktop/${_ni_release}/deb/ni/noble"

source=(
  "${_ni_debs[@]/#/${_ni_base}/}"
  nikal-0001-no-strncpy.patch
  ni-daqmx-omarchy
  ni-daqmx.hook
  ni-daqmx.sysusers
  ni-daqmx.tmpfiles
)
noextract=("${_ni_debs[@]##*/}")
sha256sums=(
  "${_ni_sha256s[@]}"
  SKIP SKIP SKIP SKIP SKIP
)

package() {
  local deb
  for deb in "${_ni_debs[@]##*/}"; do
    bsdtar -xOf "$deb" 'data.tar.*' | bsdtar -xf - -C "$pkgdir"
    # Keep NI's Debian maintainer scripts for reference and debugging.
    mkdir -p "$pkgdir/usr/share/ni-daqmx-omarchy/debian/${deb%%_*}"
    bsdtar -xOf "$deb" 'control.tar.*' \
      | bsdtar -xf - -C "$pkgdir/usr/share/ni-daqmx-omarchy/debian/${deb%%_*}"
  done

  _merge_usr
  rm -rf "$pkgdir/etc/apt"
  # Passwordless root for NI's "webserv" user (an NI Linux RT account); not wanted here.
  rm -rf "$pkgdir/etc/sudoers.d"

  # Kernel-compatibility patches for the open-source NI-KAL shim.
  local nikal=("$pkgdir"/usr/src/nikal-*)
  patch -d "$nikal" -p1 < "$srcdir/nikal-0001-no-strncpy.patch"

  # The object-broker registrations NI's postinst scripts perform, replayed by ni-daqmx.install.
  grep -ho 'orbClassMap /x64 /file [^ ]*' "$pkgdir"/usr/share/ni-daqmx-omarchy/debian/*/postinst \
    | awk '{print $4}' > "$pkgdir/usr/share/ni-daqmx-omarchy/orb-classmaps.list"

  install -Dm644 "$srcdir/ni-daqmx.sysusers" "$pkgdir/usr/lib/sysusers.d/ni-daqmx.conf"
  install -Dm644 "$srcdir/ni-daqmx.tmpfiles" "$pkgdir/usr/lib/tmpfiles.d/ni-daqmx.conf"
  install -Dm755 "$srcdir/ni-daqmx-omarchy" "$pkgdir/usr/bin/ni-daqmx-omarchy"
  install -Dm644 "$srcdir/ni-daqmx.hook" "$pkgdir/usr/share/libalpm/hooks/95-ni-daqmx.hook"
}

# Arch keeps everything under /usr: /lib, /bin, /sbin and /usr/sbin are symlinks there.
_merge_usr() {
  local from to
  for from in lib lib64 bin sbin usr/sbin usr/lib64; do
    [[ -d $pkgdir/$from && ! -L $pkgdir/$from ]] || continue
    case $from in
      lib|lib64|usr/lib64) to=usr/lib ;;
      *) to=usr/bin ;;
    esac
    mkdir -p "$pkgdir/$to"
    cp -a "$pkgdir/$from/." "$pkgdir/$to/"
    rm -rf "$pkgdir/${from:?}"
  done
}
